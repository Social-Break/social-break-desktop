<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>SocialBreakTray</AssemblyName>
    <RootNamespace>SocialBreakTray</RootNamespace>
    <!-- No console window behind the tray icon - this is a background app,
         not a CLI tool. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Keep in step with installer/SocialBreakTray.iss's MyAppVersion and
         the release tag. Without this the exe's file properties reported
         1.0.0.0 for every build, whatever version it actually shipped as,
         which makes "which build is this?" unanswerable from a user's
         machine. -->
    <Version>1.0.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- <ApplicationIcon> only stamps the icon into the exe's Win32 resource
         group, which is reachable at runtime solely via
         Icon.ExtractAssociatedIcon - and that API hands back a single 32x32
         frame, whatever sizes the .ico actually holds. Everything drawn from
         it (tray icon, caption, header) was therefore a rescale of that one
         frame. Embedding the file as well lets Theme pick the real 16/32/48/
         256 frames. -->
    <EmbeddedResource Include="app.ico" LogicalName="SocialBreakTray.app.ico" />
  </ItemGroup>

</Project>
